# Copy this file to .env and fill in real values.
# This is the file `docker compose up` reads — it configures every service
# (db, redis, backend, celery_worker, celery_beat, frontend) in one place.
#
# Running the backend natively instead (no Docker)? Use backend/.env.example.

# ── Frontend (Vite build args — baked in at build time) ───────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=

# ── Database (MySQL) ────────────────────────────────────────────────────────
DB_NAME=bio_batch_assist
DB_USER=bio_user
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False

# ── Email (Gmail SMTP) — used for report/alert emails ─────────────────────────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Fallback recipient when a tool/task doesn't get an explicit email address
ADMIN_EMAIL=

# ── Azure Blob Storage (profile pictures, RAG source PDFs) ────────────────────
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=
# Alternative to the two vars above, used by the RAG ingestion script:
AZURE_STORAGE_CONNECTION_STRING=

# ── AI / LLM ───────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional: raises HuggingFace's anonymous rate limit when downloading the
# embeddings model used by the RAG pipeline.
HF_TOKEN=
