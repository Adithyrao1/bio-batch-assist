# Copy this file to backend/.env and fill in real values.
# Used when running the backend natively (python manage.py runserver).
# When running via `docker compose`, the root .env file is used instead —
# see .env.example at the repo root.

# ── Core security ───────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (MySQL) ─────────────────────────────────────────────────────────
DB_NAME=bio_batch_assist
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ── CORS / CSRF ───────────────────────────────────────────────────────────────
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# ── Email (Gmail SMTP) — used for report/alert emails ─────────────────────────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Fallback recipient when a tool/task doesn't get an explicit email address
ADMIN_EMAIL=

# ── Azure Blob Storage (profile pictures, RAG source PDFs) ────────────────────
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=
# Alternative to the two vars above, used by the RAG ingestion script:
AZURE_STORAGE_CONNECTION_STRING=

# ── AI / LLM ───────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional: raises HuggingFace's anonymous rate limit when downloading the
# embeddings model used by the RAG pipeline.
HF_TOKEN=
